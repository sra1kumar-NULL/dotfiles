// Minimal fastfetch for the mango/Hyprland rice.
// Colours use ANSI names on purpose: kitty's palette is regenerated from the
// wallpaper by matugen, so this follows the theme with no extra plumbing.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "green" },
    "key": { "width": 11 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "separator", "string": "─" },
    { "type": "os",       "key": "  os",    "format": "{name} {version}" },
    { "type": "kernel",   "key": "  kernel" },
    { "type": "uptime",   "key": "  uptime" },
    { "type": "packages", "key": " 󰏖 pkgs" },
    { "type": "shell",    "key": "  shell" },
    { "type": "wm",       "key": "  wm" },
    { "type": "terminal", "key": "  term" },
    { "type": "separator", "string": "─" },
    { "type": "cpu",      "key": "  cpu",   "showPeCoreCount": true },
    { "type": "gpu",      "key": " 󰢮 gpu",   "driverSpecific": true },
    { "type": "memory",   "key": "  ram" },
    { "type": "disk",     "key": " 󰋊 disk",  "folders": "/" },
    { "type": "battery",  "key": "  batt" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 },
    "break"
  ]
}
